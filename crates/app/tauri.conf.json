{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM Router",
  "version": "0.1.6",
  "identifier": "com.llmrouter.app",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --prefix ../ui",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "LLM Router",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3NzcwQ0U2QTVCODUyMDkKUldRSlVyaWw1Z3gzSjJYM2xVUHd2eDdnSUNWNFU0SEY0QzZ5ak1HYy9OOHQvT1BWNW02WjllclEK",
      "endpoints": [
        "https://github.com/sparkjokerben/local-llm-router/releases/latest/download/latest.json"
      ]
    }
  }
}
